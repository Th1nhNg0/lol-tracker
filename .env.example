# Secrets only. Pass with --env-file; real environment variables take precedence.
RIOT_API_KEY=replace_with_riot_api_key
# Required for Discord mode (`run` without --no-discord).
DISCORD_TOKEN=replace_with_discord_bot_token
# Optional. Only read when [llm] enabled = true. May be empty for a localhost server.
LLM_API_KEY=
